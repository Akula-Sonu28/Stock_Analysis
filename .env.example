# Kite MCP Configuration
# Copy this file to .env and configure your settings

# Data Source Selection
# Options: "csv", "kite_mcp", "auto"
# - "csv": Use CSV files from Holding/ directory (default)
# - "kite_mcp": Fetch live holdings from Kite via MCP
# - "auto": Try Kite MCP first, fallback to CSV if unavailable
DATA_SOURCE=csv

# Enable Kite MCP Integration
KITE_MCP_ENABLED=false

# Kite MCP Cache Settings
# How long to cache Kite data in minutes (reduces API calls)
KITE_CACHE_TTL_MINUTES=5

# Automatic Fallback
# If Kite MCP fails, should it automatically fallback to CSV?
AUTO_FALLBACK_TO_CSV=true

# Portfolio Settings
AVAILABLE_FUNDS=114129.60

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
